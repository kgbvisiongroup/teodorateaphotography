# Port na kome radi aplikacija
PORT=3000

# Početno korisničko ime za admin panel (kasnije se menja u Podešavanjima)
ADMIN_USERNAME=admin

# Početna lozinka za admin panel (koristi se samo pri prvom pokretanju;
# kasnije je menjate u Podešavanjima)
ADMIN_PASSWORD=promenite-ovu-lozinku

# Gde se čuvaju fotografije i podešavanja
# DATA_DIR=./data

# Najveći dozvoljen pojedinačni fajl u MB (10240 = 10 GB)
# MAX_FILE_MB=10240
